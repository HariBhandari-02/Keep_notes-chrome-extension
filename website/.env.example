# Embeddable feedback form shown on /uninstall.html (Google Forms or Tally).
# Google Forms: Send -> "<>" embed -> copy the iframe src, e.g.
#   https://docs.google.com/forms/d/e/XXXX/viewform?embedded=true
# Tally: https://tally.so/r/XXXX
VITE_FEEDBACK_FORM_URL=

