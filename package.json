{
  "name": "keep-notes",
  "private": true,
  "version": "1.0.1",
  "description": "A fast, local-first floating notepad for Chrome.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "security:check": "npm run typecheck && npm test && npm run build && npm run verify && npm run audit",
    "sonar": "npm run test:coverage && bash scripts/sonar.sh && npm run sonar:fetch",
    "sonar:fetch": "node --experimental-strip-types scripts/sonar-fetch.ts",
    "sonar:gate": "node --experimental-strip-types scripts/sonar-gate.ts",
    "verify": "node scripts/verify-dist.mjs",
    "zip": "npm run build && cd dist && zip -r \"../keep-notes-$npm_package_version.zip\" .",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website ci && npm --prefix website run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "re-resizable": "^6.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
